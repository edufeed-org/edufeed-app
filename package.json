{
  "name": "edufeed-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "husky",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "check": "pnpm paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "check:watch": "pnpm paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --environment node",
    "test:component": "vitest run --environment jsdom",
    "test:e2e": "playwright test",
    "machine-translate": "inlang machine translate --project project.inlang",
    "publish:vocabs": "node scripts/publish-edufeed-vocabs.mjs",
    "publish:forms": "node scripts/publish-edufeed-forms.mjs",
    "publish:webxdc-app": "node scripts/publish-webxdc-app.mjs",
    "cleanup:legacy-vocab": "node scripts/delete-legacy-concept-kinds.mjs"
  },
  "devDependencies": {
    "@djot/djot": "^0.3.2",
    "@eslint/compat": "^1.2.5",
    "@eslint/js": "^9.18.0",
    "@fontsource-variable/roboto-condensed": "^5.2.8",
    "@fontsource-variable/yanone-kaffeesatz": "^5.2.7",
    "@inlang/cli": "^3.1.9",
    "@inlang/paraglide-js": "2.16.0",
    "@playwright/test": "^1.59.1",
    "@sveltejs/adapter-auto": "^6.0.0",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.57.1",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "amb-nostr-converter": "https://git.edufeed.org/api/packages/edufeed/npm/amb-nostr-converter/-/0.0.0-2f68a71/amb-nostr-converter-0.0.0-2f68a71.tgz",
    "applesauce-accounts": "^6.2.0",
    "applesauce-actions": "^6.2.0",
    "applesauce-content": "^6.2.0",
    "applesauce-core": "^6.2.0",
    "applesauce-loaders": "^6.2.0",
    "applesauce-relay": "^6.2.1",
    "applesauce-signers": "^6.2.2",
    "asciidoctor": "^3.0.4",
    "blossom-client-sdk": "^4.1.0",
    "daisyui": "^5.5.19",
    "dompurify": "^3.4.1",
    "dotenv": "^17.4.2",
    "embla-carousel": "^8.6.0",
    "embla-carousel-svelte": "^8.6.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-svelte": "^3.17.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.4.0",
    "livekit-client": "^2.18.5",
    "maplibre-gl": "^4.7.1",
    "marked": "^16.4.0",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "qrcode": "^1.5.4",
    "rxjs": "^7.8.2",
    "svelte": "^5.55.4",
    "svelte-check": "^4.4.6",
    "svelte-maplibre": "^1.3.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.0.0",
    "unpdf": "^1.6.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.5",
    "ws": "^8.20.0"
  },
  "dependencies": {
    "@contextvm/mcp-sdk": "^1.30.0",
    "@contextvm/sdk": "^0.13.10",
    "@fiatjaf/promenade-trusted-dealer": "npm:@jsr/fiatjaf__promenade-trusted-dealer@^0.4.3",
    "@fontsource-variable/caveat": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/outfit": "^5.2.8",
    "@mozilla/readability": "^0.6.0",
    "@napi-rs/canvas": "^1.0.2",
    "@noble/ciphers": "^2.2.0",
    "@noble/hashes": "^1.8.0",
    "applesauce-common": "^6.2.0",
    "applesauce-common-concord": "npm:applesauce-common@0.0.0-concord-20260714212055",
    "applesauce-concord": "0.0.0-concord-20260714212055",
    "applesauce-core-concord": "npm:applesauce-core@0.0.0-concord-20260714212055",
    "bible-passage-reference-parser": "^3.2.0",
    "cally": "^0.9.2",
    "fflate": "^0.8.3",
    "h5p-standalone": "^3.8.2",
    "light-bolt11-decoder": "3.2.0",
    "linkedom": "^0.18.12",
    "nostr-idb": "^5.0.0",
    "nostr-tools": "^2.24.1",
    "nostr-vocab-core": "https://git.edufeed.org/api/packages/edufeed/npm/nostr-vocab-core/-/0.2.3/nostr-vocab-core-0.2.3.tgz",
    "nostr-vocab-skos-import": "https://git.edufeed.org/api/packages/edufeed/npm/nostr-vocab-skos-import/-/0.2.4/nostr-vocab-skos-import-0.2.4.tgz",
    "pdfjs-dist": "4.10.38",
    "sharp": "^0.34.5",
    "smol-toml": "^1.8.0",
    "ts-mls": "2.0.0-rc.13"
  },
  "pnpm": {
    "patchedDependencies": {
      "applesauce-content@6.2.0": "patches/applesauce-content@6.2.0.patch",
      "ts-mls": "patches/ts-mls.patch"
    }
  },
  "lint-staged": {
    "*.{js,svelte}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": "prettier --write",
    "messages/*.json": "scripts/check-i18n-keys.sh"
  }
}
