    {
      "d": "edufeed-membership",
      "name": "Verifizierte edufeed.org-Adresse erhalten",
      "description": "Als verifiziertes Mitglied bekommst du eine gut merkbare Adresse (dein-name@edufeed.org) und kannst auf edufeed.org-Community-Relays veröffentlichen. Erzähl uns kurz etwas über dich, damit wir deinen Antrag prüfen können.",
      "fields": [
        {
          "id": "wished_handle",
          "type": "text",
          "label": "Deine Wunsch-Adresse",
          "required": true,
          "min": 2,
          "max": 30,
          "pattern": "^[a-z0-9._-]+$",
          "placeholder": "z. B. maria"
        },
        {
          "id": "full_name",
          "type": "text",
          "label": "Vollständiger Name",
          "required": true
        },
        {
          "id": "affiliation",
          "type": "text",
          "label": "Institution / Schule"
        },
        {
          "id": "role",
          "type": "text",
          "label": "Rolle",
          "placeholder": "z. B. Lehrkraft, Verlag, Forschung"
        },
        {
          "id": "motivation",
          "type": "textarea",
          "label": "Warum möchtest du Mitglied von edufeed.org werden?",
          "required": true
        }
      ]
    }
  ]
}
