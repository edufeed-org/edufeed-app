        },
        {
          "id": "audience",
          "type": "select",
          "label": "Zielgruppe",
          "multiple": true,
          "vocabRef": "lrmi-audience",
          "output": "amb:audience"
        },
        {
          "id": "educationalLevel",
          "type": "select",
          "label": "Bildungsstufe",
          "multiple": true,
          "vocabRef": "educational-level",
          "output": "amb:educationalLevel"
        },
        {
          "id": "interactivityType",
          "type": "select",
          "label": "Interaktivität",
          "vocabRef": "interactivity-type",
          "output": "amb:interactivityType"
        },
        {
          "id": "conditionsOfAccess",
          "type": "select",
          "label": "Zugangsbedingungen",
          "vocabRef": "conditions-of-access",
          "output": "amb:conditionsOfAccess"
        },
        {
          "id": "inLanguage",
          "type": "text",
          "label": "Sprache (BCP47)",
          "output": "amb:inLanguage"
        },
        {
          "id": "license",
          "type": "text",
          "label": "Lizenz-URI",
          "required": true,
          "output": "amb:license"
        },
        {
          "id": "keywords",
          "type": "text",
          "label": "Schlagworte (kommagetrennt)",
          "output": "amb:keywords"
        }
      ]
    },
    {
      "d": "ekw-full",
