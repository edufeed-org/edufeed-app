          "type": "text",
          "label": "Titel",
          "required": true,
          "output": "amb:name"
        },
        {
          "id": "description",
          "type": "textarea",
          "label": "Beschreibung",
          "required": true,
          "output": "amb:description"
        },
        {
          "id": "about",
          "type": "select",
          "label": "Fach",
          "multiple": true,
          "vocabRef": "ekw-fach",
          "output": "amb:about"
        },
        {
          "id": "learningResourceType",
          "type": "select",
          "label": "Ressourcentyp",
          "required": true,
          "vocabRef": "hcrt",
          "output": "amb:learningResourceType"
        },
        {
          "id": "educationalLevel",
          "type": "select",
          "label": "Bildungsstufe",
