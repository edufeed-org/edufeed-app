        },
        {
          "id": "audience",
          "type": "select",
          "label": "Zielgruppe",
          "multiple": true,
          "vocabRef": "lrmi-audience",
          "output": "amb:audience"
        },
        {
          "id": "didacticConcept",
          "type": "select",
          "label": "Didaktisches Konzept",
          "multiple": true,
          "vocabRef": "didaktisches-konzept",
