# Communikey-Svelte Environment Configuration

# ============================================
# Required Configuration
# ============================================

# The public URL where the application will be accessible
# This is required by SvelteKit for security (CSRF protection)
# Example: https://comcal.net or https://your-domain.com
ORIGIN=https://your-domain.com

# Port the application will listen on inside the container
# Default: 3000 (should match docker-compose.yml and Dockerfile)
PORT=3000

# Node environment
# Options: production, development
NODE_ENV=production

# ============================================
# App Branding
# ============================================

APP_NAME=ComCal
CLIENT_NAME=Edufeed

# ============================================
# Theme Configuration
# ============================================

# Default theme when system prefers light mode
# Options: light, dark, stil, stil-dark, rpi, rpi-dark
THEME_DEFAULT_LIGHT=stil

# ============================================
# Hero Image Configuration (Whitelabel)
# ============================================
# Optional - when set, replaces default gradient with a background image + frosted glass overlay
# Supports both local paths (/landing.webp) and external URLs (https://cdn.example.com/hero.jpg)

# LANDING_HERO_IMAGE=/landing.webp
# DISCOVER_HERO_IMAGE=/landing.webp

# ============================================
# Favicon Configuration (Whitelabel)
# ============================================
# Optional - defaults to files in /static if not set
# Supports both local paths and external URLs (CDN)

# FAVICON_ICO=/favicon.ico
# FAVICON_SVG=/favicon.svg
# FAVICON_32=/favicon-32x32.png
# FAVICON_16=/favicon-16x16.png

# Default theme when system prefers dark mode
# Options: light, dark, stil, stil-dark, rpi, rpi-dark
THEME_DEFAULT_DARK=stil-dark
APP_LOGO=https://blossom.edufeed.org/f22e1410f09a9130757704b6dcd4c34774d2926b9cfd6cf2e4c4675c64d4333b.webp
APP_GIT_REPO=https://github.com/edufeed-org/comcal

# ============================================
# Nostr Relays
# ============================================

# Fallback relays for users without kind 10002 relay list (comma-separated)
FALLBACK_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://nostr.wine

# ============================================
# App-Specific Relays
# ============================================
# These relays store specific content types IN ADDITION to user's outbox.
# Users can override via kind 30002 relay sets with d-tag: {APP_NAME}/{category}

# Calendar event relays (kinds 31922-31925)
CALENDAR_RELAYS=wss://relay-rpi.edufeed.org

# Communikey relays for community events (kinds 10222, 30222)
COMMUNIKEY_RELAYS=wss://relay-rpi.edufeed.org

# AMB relays for educational content with NIP-50 search (kind 30142)
AMB_RELAYS=ws://localhost:3334

# Long-form content relays (kind 30023 articles)
LONGFORM_CONTENT_RELAY=

# Kanban board relays (kind 30301 boards, 30302 cards, 8571 patches)
KANBAN_RELAYS=wss://relay-rpi.edufeed.org

# ============================================
# Gated Mode Configuration
# ============================================
# When gated mode is enabled, the app fetches content ONLY from app-specific
# relays (calendar, communikey, educational, longform) - fallback relays are excluded.
# This allows app operators to control what content users see.

# Default gated mode state (true/false)
GATED_MODE_DEFAULT=false

# Force gated mode - when true, users cannot disable it
GATED_MODE_FORCE=false

# ============================================
# Curated Mode Configuration
# ============================================
# Curated mode restricts primary content to specific authors.
# Social content (reactions, comments, chat, targeted publications) is not filtered.
#
# Global defaults — applied to ALL content types unless overridden per category:
# Comma-separated naddr identifiers pointing to kind 30000 follow sets
CURATED_PUBKEYS_SETS=
# Comma-separated hex pubkeys or npub-encoded pubkeys (unioned with sets above)
CURATED_PUBKEYS=
#
# Per-category overrides — when either var is set for a category, it COMPLETELY
# REPLACES the global config for that category (not merged):
# CURATED_PUBKEYS_SETS_CALENDAR=
# CURATED_PUBKEYS_CALENDAR=
# CURATED_PUBKEYS_SETS_COMMUNIKEY=
# CURATED_PUBKEYS_COMMUNIKEY=
# CURATED_PUBKEYS_SETS_EDUCATIONAL=
# CURATED_PUBKEYS_EDUCATIONAL=
# CURATED_PUBKEYS_SETS_LONGFORM=
# CURATED_PUBKEYS_LONGFORM=
# CURATED_PUBKEYS_SETS_KANBAN=
# CURATED_PUBKEYS_KANBAN=

# ============================================
# Web of Trust (WoT) Content Filtering
# ============================================
# WoT extends curated mode by automatically including follows of anchor pubkeys.
# Anchor pubkeys' kind 3 contact lists are fetched, and their follows become allowed authors.
# This scales organically as trusted educators grow their networks.

# Enable WoT filtering globally (true/false)
WOT_ENABLED=false

# Include the logged-in user's own follows as allowed authors (true/false)
WOT_INCLUDE_USER_FOLLOWS=true

# Global anchor pubkeys (hex or npub, comma-separated)
# These pubkeys + their follows become allowed authors for all categories
WOT_ANCHOR_PUBKEYS=

# Per-category overrides (when set, replaces global anchors for that category):
# WOT_ANCHOR_PUBKEYS_CALENDAR=
# WOT_ANCHOR_PUBKEYS_COMMUNIKEY=
# WOT_ANCHOR_PUBKEYS_EDUCATIONAL=
# WOT_ANCHOR_PUBKEYS_LONGFORM=
# WOT_ANCHOR_PUBKEYS_KANBAN=

# ============================================
# NIP-65 Relay List Discovery
# ============================================

# Well-known relays for discovering user relay lists (kind 10002)
# These relays specialize in storing NIP-65 relay list metadata
RELAY_LIST_LOOKUP_RELAYS=wss://purplepag.es,wss://relay.damus.io,wss://nos.lol

# Profile indexer relays for bulk profile lookups (kind 0)
INDEXER_RELAYS=wss://purplepag.es

# ============================================
# Default Blossom Servers
# ============================================

# Default Blossom media servers for new users
DEFAULT_BLOSSOM_SERVERS=https://blossom.primal.net,https://cdn.satellite.earth

# ============================================
# Calendar Configuration
# ============================================

# Week start day: 0 = Sunday, 1 = Monday, etc.
CALENDAR_WEEK_START_DAY=1

# Locale for date/time formatting (e.g., de-DE, en-US)
CALENDAR_LOCALE=de-DE

# Time format: 12h or 24h
CALENDAR_TIME_FORMAT=24h

# Featured authors shown on /calendar as a landing avatar rail and as an
# "Autoren" filter dropdown. Comma-separated list of npubs (bech32) or
# 64-character hex pubkeys. Purely presentational — does NOT affect which
# events are fetched. Disabling the rail is done by leaving this empty.
CALENDAR_FEATURED_AUTHORS=

# ============================================
# Signup Configuration
# ============================================

# Suggested users to follow during signup (comma-separated npubs)
SIGNUP_SUGGESTED_USERS=npub1f7jar3qnu269uyx5p0e4v24hqxjnxysxudvujza2ur5ehltvdeqsly2fx9,npub1r30l8j4vmppvq8w23umcyvd3vct4zmfpfkn4c7h2h057rmlfcrmq9xt9ma,npub1tgftg8kptdrxxg0g3sm3hckuglv3j0uu3way4vylc5qyt0f44m0s3gun6e

# Communities (comma-separated npubs or hex pubkeys) that brand-new accounts
# auto-join right after signup completes — published as an entry in the
# user's kind 30000 follow set with d="communities". Leave empty to disable.
# Example:
# SIGNUP_AUTO_JOIN_COMMUNITIES=npub1hhpplya3ut9h2cyvant6pgq2w7thnkfk0hyhnz7e7gflqmy4h3yqp2p4pk
SIGNUP_AUTO_JOIN_COMMUNITIES=

# ============================================
# Blossom (Media Uploads)
# ============================================

# Max file size in bytes (default: 5MB = 5242880)
BLOSSOM_MAX_FILE_SIZE=5242880

# ============================================
# Geocoding (OpenCage API)
# ============================================

# OpenCage API key for geocoding addresses
# IMPORTANT: This is a SECRET - keep it server-side only!
# Get your key at: https://opencagedata.com/api
# Free tier: 2,500 requests/day
GEOCODING_API_KEY=your-api-key-here

# Cache duration in days
GEOCODING_CACHE_DURATION_DAYS=30

# Minimum address length for geocoding
GEOCODING_MIN_ADDRESS_LENGTH=10

# Minimum confidence score from OpenCage (0-10)
GEOCODING_MIN_CONFIDENCE_SCORE=5

# Require address components (true/false)
GEOCODING_REQUIRE_ADDRESS_COMPONENTS=false

# Accepted component types (comma-separated)
GEOCODING_ACCEPTED_COMPONENT_TYPES=road,house,building,retail,commercial,industrial,residential,address,postcode,street,neighbourhood,city,town,village,municipality,county,state,country,amenity,venue,place,locality,university

# ============================================
# Imprint / Legal Information
# ============================================

IMPRINT_ENABLED=true
IMPRINT_ORGANIZATION=ComCal GbR

# Address
IMPRINT_ADDRESS_STREET=
IMPRINT_ADDRESS_POSTAL_CODE=
IMPRINT_ADDRESS_CITY=
IMPRINT_ADDRESS_COUNTRY=

# Contact
IMPRINT_CONTACT_EMAIL=mail@comcal.net
IMPRINT_CONTACT_PHONE=

# Legal
IMPRINT_REPRESENTATIVE=
IMPRINT_REGISTRATION_NUMBER=
IMPRINT_VAT_ID=
IMPRINT_RESPONSIBLE_FOR_CONTENT=

# Funding Information (shown on imprint page)
# JSON array of {image, text} objects. Example with multiple entries:
# IMPRINT_FUNDING=[{"image":"/BMBFSFJ.png","text":"Förderkennzeichen: 01PZ24007"},{"image":"/other.png","text":"Other funding"}]
IMPRINT_FUNDING=[{"image":"/BMBFSFJ.png","text":"Förderkennzeichen: 01PZ24007"}]

# ============================================
# Footer Configuration
# ============================================

# Funding acknowledgment text shown in footer
FOOTER_FUNDING_TEXT=gefördert vom BMBFSFJ (FKZ01PZ24007)

# ============================================
# Educational Content
# ============================================

# Search debounce delay in milliseconds
EDUCATIONAL_SEARCH_DEBOUNCE_MS=300

# SKOS vocabulary keys
EDUCATIONAL_VOCAB_LEARNING_RESOURCE_TYPE=hcrt
EDUCATIONAL_VOCAB_ABOUT=hochschulfaechersystematik
EDUCATIONAL_VOCAB_AUDIENCE=intendedEndUserRole

# ============================================
# Resource Form Variants
# ============================================

# Comma-separated list of metadata-form variants enabled on this deployment.
# Available variants: amb (AMB-Bildungsmaterial), ekw (EKW-Bildungsmaterial).
# Order defines picker order + default. Single-variant deployments skip the picker.
# Default: amb
RESOURCE_FORM_VARIANTS=amb

# ============================================
# Default-publisher script config (scripts/publish-*.mjs)
# ============================================

EDUFEED_PUBLISHER_NSEC=
EDUFEED_PUBLISH_RELAYS=wss://relay-rpi.edufeed.org
# Filled in after running publish:vocabs — used by publish:forms.
# One var per scheme d-tag (dashes become underscores, uppercased):
SCHEME_NADDR_SCHULFAECHER=
SCHEME_NADDR_HOCHSCHULFAECHER=
SCHEME_NADDR_HCRT=
SCHEME_NADDR_NEW_LRT=
SCHEME_NADDR_LRMI_AUDIENCE=
SCHEME_NADDR_EDUCATIONAL_LEVEL=
SCHEME_NADDR_INTERACTIVITY_TYPE=
SCHEME_NADDR_CONDITIONS_OF_ACCESS=
# EKW vocabularies (kind 39737) — populate after publishing the EKW vocabs.
SCHEME_NADDR_KLASSENSTUFEN=
SCHEME_NADDR_SCHULART=
SCHEME_NADDR_EKW_FACH=
SCHEME_NADDR_DIDAKTISCHES_KONZEPT=
SCHEME_NADDR_METHODE=

# ============================================
# /api/enrich (URL → form-prefill metadata)
# ============================================
# Optional. When set, /api/enrich uses an Anthropic-grounded LLM to fill
# SKOS-typed form fields (learningResourceType, gradeLevels, schoolTypes, …)
# from the page's OpenGraph + Readability text. Without it the route still
# works and degrades to OpenGraph-only output.
# ANTHROPIC_API_KEY=
